spring.application.name=AgriTech-Platform-API-Gateway
server.port=8080

# =========================================================
# REACTIVE WEBFLUX
# =========================================================
spring.main.web-application-type=reactive

# =========================================================
# EUREKA CLIENT
# =========================================================
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.fetch-registry=true
eureka.client.register-with-eureka=true

eureka.instance.prefer-ip-address=true
eureka.instance.instance-id=${spring.application.name}:${server.port}:${random.value}

# =========================================================
# GATEWAY DISCOVERY LOCATOR
# =========================================================
spring.cloud.gateway.server.webflux.discovery.locator.enabled=true
spring.cloud.gateway.server.webflux.discovery.locator.lower-case-service-id=true


spring.cloud.gateway.server.webflux.routes[0].id=AgriTech-Auth-Service
spring.cloud.gateway.server.webflux.routes[0].uri=lb://AGRITECH-AUTH-SERVICE
spring.cloud.gateway.server.webflux.routes[0].predicates[0]=Path=/api/auth/**

spring.cloud.gateway.server.webflux.routes[1].id=AgriTech-Sensor-Service
spring.cloud.gateway.server.webflux.routes[1].uri=lb://AGRITECH-SENSOR-SERVICE
spring.cloud.gateway.server.webflux.routes[1].predicates[0]=Path=/api/sensors/**


spring.cloud.gateway.server.webflux.routes[2].id=AgriTech-Crop-Monitoring-Service
spring.cloud.gateway.server.webflux.routes[2].uri=lb://AGRITECH-CROP-MONITORING-SERVICE
spring.cloud.gateway.server.webflux.routes[2].predicates[0]=Path=/api/crops/**


spring.cloud.gateway.server.webflux.routes[3].id=AgriTech-Irrigation-Service
spring.cloud.gateway.server.webflux.routes[3].uri=lb://AGRITECH-IRRIGATION-SERVICE
spring.cloud.gateway.server.webflux.routes[3].predicates[0]=Path=/api/irrigation/**


spring.cloud.gateway.server.webflux.globalcors.add-to-simple-url-handler-mapping=true

spring.cloud.gateway.server.webflux.globalcors.cors-configurations.[/**].allowedOrigins=http://localhost:5173,http://127.0.0.1:5173

spring.cloud.gateway.server.webflux.globalcors.cors-configurations.[/**].allowedMethods=GET,POST,PUT,DELETE,OPTIONS

spring.cloud.gateway.server.webflux.globalcors.cors-configurations.[/**].allowedHeaders=*

spring.cloud.gateway.server.webflux.globalcors.cors-configurations.[/**].allowCredentials=true

