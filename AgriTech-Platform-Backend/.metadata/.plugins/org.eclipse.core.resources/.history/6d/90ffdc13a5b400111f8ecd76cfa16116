spring.application.name=AgriTech-Platform-API-Gateway
server.port=8080

# Spring Cloud Gateway - Discovery Locator

spring.cloud.gateway.discovery.locator.enabled=true
spring.cloud.gateway.discovery.locator.lower-case-service-id=true

# Auth Service Route

spring.cloud.gateway.routes[0].id=auth-service-route
spring.cloud.gateway.routes[0].uri=lb://AUTH-SERVICE
spring.cloud.gateway.routes[0].predicates[0]=Path=/api/auth/**

# Sensor Service Route

spring.cloud.gateway.routes[1].id=sensor-service-route
spring.cloud.gateway.routes[1].uri=lb://SENSOR-SERVICE
spring.cloud.gateway.routes[1].predicates[0]=Path=/api/sensors/**

# Crop Service - Crops

spring.cloud.gateway.routes[2].id=crop-service-crops-route
spring.cloud.gateway.routes[2].uri=lb://CROP-MONITORING-SERVICE
spring.cloud.gateway.routes[2].predicates[0]=Path=/api/crops/**

# Crop Service - Monitoring

spring.cloud.gateway.routes[3].id=crop-service-monitoring-route
spring.cloud.gateway.routes[3].uri=lb://CROP-MONITORING-SERVICE
spring.cloud.gateway.routes[3].predicates[0]=Path=/api/crop-monitoring/**

# Irrigation Service Route

spring.cloud.gateway.routes[4].id=irrigation-service-route
spring.cloud.gateway.routes[4].uri=lb://IRRIGATION-SERVICE
spring.cloud.gateway.routes[4].predicates[0]=Path=/api/irrigation/**

# Global CORS

spring.cloud.gateway.globalcors.cors-configurations.[/**].allowedOrigins[0]=http://localhost:5173
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowedOrigins[1]=http://127.0.0.1:5173
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowedOrigins[2]=http://localhost:3000

spring.cloud.gateway.globalcors.cors-configurations.[/**].allowedMethods[0]=GET
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowedMethods[1]=POST
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowedMethods[2]=PUT
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowedMethods[3]=DELETE
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowedMethods[4]=OPTIONS

spring.cloud.gateway.globalcors.cors-configurations.[/**].allowedHeaders=*
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowCredentials=true

# Eureka Client

eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.fetch-registry=true
eureka.client.register-with-eureka=true

# Eureka Instance

eureka.instance.prefer-ip-address=true
eureka.instance.instance-id=${spring.application.name}:${server.port}:${random.value}

